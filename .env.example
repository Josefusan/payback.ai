# Copy to your shell profile or a local .env (gitignored). SANDBOX values only.

# PayPal sandbox app — https://developer.paypal.com/dashboard/ (Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id

# Shared admin token for the mutating routes — POST /api/sync, POST /api/review/:id/resolve,
# POST /api/actions/propose, POST /api/actions/:id/approve, PUT /api/settings/auto_post_threshold,
# PUT /api/budgets. Present it as `X-Admin-Token: <token>` (or `Authorization: Bearer <token>`); the guard
# fails closed (503) if it is unset. At deploy: `wrangler secret put ADMIN_TOKEN`. Locally this is the SAME
# VALUE as PAYBACK_ADMIN_TOKEN (the name the seed and eval env files use) — set both to one long random string.
ADMIN_TOKEN=

# Cloudflare (Workers AI / Clef via REST; wrangler uses `wrangler login` instead)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Evals — LLM judge
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-sonnet-4-5

# Optional sponsor tools
POSTMAN_API_KEY=
CHANNEL3_API_KEY=
